# ============================================================================
#  依赖
# ============================================================================
node_modules/
m0-bench/node_modules/
m0-bundle/node_modules/

# ============================================================================
#  构建产物（可用 npm run build / node tools/build-portable.mjs 重新生成）
# ============================================================================
dist/
m0-bundle/dist/
.portable-build/

# 便携版解压目录：只提交 release/*.zip，目录本身是构建输出
release/*/

# ============================================================================
#  与项目无关的本地文件 —— 绝不允许进入仓库
# ============================================================================
# backup/ 是浏览器扩展的本地备份（含第三方扩展源码、.crx、注册表导出），
# 与游戏完全无关。曾用于一次系统维护操作，属于本机私有数据。
backup/

# ★ M6：m6-webgpu/ 是**整仓副本**（WebGPU 平行预研，见 docs/14-M6-WebGPU-预研登记.md）。
# 它自带 .git，把它当普通目录提交会变成一个**没有内容的 gitlink** —— 克隆出来是空壳。
# 预研对主项目的唯一写入是 docs/14 那一份登记，因此这里整体排除。
# （若将来预研成果要回流，按 docs/01 §7.2 走变更申请，而不是把副本塞进仓库。）
m6-webgpu/

# ============================================================================
#  测试中间产物
# ============================================================================
# results/ 下只保留结论性证据（各阶段测试结论、手感量化记录、体积门禁历史）。
# 调试过程中的中间日志统一归档到 results/archive/，本地保留但不入库：
# 它们是可重新生成的，且数量会随迭代无限增长。
results/archive/
# 每次跑端到端都会写一份带时间戳的快照 —— 同上，属中间日志，不入库。
# （结论性证据是 m2-ten-raids.json / ttk-report.json / loot-table-report.json /
#   m3-map-render.txt / level-golden-*.json 这些）
results/m2-smoke-*.json
# *.log 是控制台重定向的临时文件（如 node tools/smoke.mjs > log）
*.log

# ============================================================================
#  本地模拟与临时目录
# ============================================================================
.friend-sim/
*.tmp
# 注入自检的临时表（tools/inject-*-tests.mjs 生成，跑完即弃）
.loot-inject/
# AI 会话的本地记忆（属本机私有数据，与游戏无关）
.workbuddy/

# ============================================================================
#  操作系统 / 编辑器
# ============================================================================
Thumbs.db
Desktop.ini
.DS_Store
.vscode/
.idea/
*.swp
